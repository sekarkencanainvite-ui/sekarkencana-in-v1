rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == 'sekarkencana.invite@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidHargaPaket(hp) {
      return hp is map
        && hp.keys().size() <= 30
        && (!('bronze' in hp) || (hp.bronze is number && hp.bronze >= 0 && hp.bronze <= 100000000))
        && (!('silver' in hp) || (hp.silver is number && hp.silver >= 0 && hp.silver <= 100000000))
        && (!('gold' in hp) || (hp.gold is number && hp.gold >= 0 && hp.gold <= 100000000))
        && (!('platinum' in hp) || (hp.platinum is number && hp.platinum >= 0 && hp.platinum <= 100000000));
    }

    function isValidLinkPaket(lp) {
      return lp is map
        && lp.keys().size() <= 30
        && (!('bronze' in lp) || (lp.bronze is string && lp.bronze.size() <= 1000))
        && (!('silver' in lp) || (lp.silver is string && lp.silver.size() <= 1000))
        && (!('gold' in lp) || (lp.gold is string && lp.gold.size() <= 1000))
        && (!('platinum' in lp) || (lp.platinum is string && lp.platinum.size() <= 1000));
    }

    function isValidHargaPromo(promo) {
      return promo is map
        && promo.keys().hasAll(['aktif', 'paket', 'hargaPromo', 'labelPromo', 'tanggalMulai', 'tanggalSelesai'])
        && promo.keys().hasOnly(['aktif', 'paket', 'hargaPromo', 'labelPromo', 'tanggalMulai', 'tanggalSelesai'])
        && promo.aktif is bool
        && isValidId(promo.paket) && promo.paket.size() <= 60
        && promo.hargaPromo is number && promo.hargaPromo >= 0 && promo.hargaPromo <= 100000000
        && promo.labelPromo is string && promo.labelPromo.size() <= 60
        && promo.tanggalMulai is string && promo.tanggalMulai.size() <= 40
        && promo.tanggalSelesai is string && promo.tanggalSelesai.size() <= 40;
    }

    function isValidTemplate(data) {
      return data.keys().hasAll([
          'namaTemplate', 'fotoThumbnail', 'linkWebsite', 'deskripsi',
          'hargaPaket', 'hargaPromo', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'namaTemplate', 'fotoThumbnail', 'linkWebsite', 'deskripsi',
          'kategori', 'linkPaket', 'hargaPaket', 'hargaPromo', 'createdAt', 'updatedAt'
        ])
        && data.namaTemplate is string && data.namaTemplate.size() >= 1 && data.namaTemplate.size() <= 120
        && data.fotoThumbnail is string && data.fotoThumbnail.size() >= 1 && data.fotoThumbnail.size() <= 500000
        && data.linkWebsite is string && data.linkWebsite.size() >= 1 && data.linkWebsite.size() <= 1000 && data.linkWebsite.matches('^https?://.+')
        && data.deskripsi is string && data.deskripsi.size() >= 1 && data.deskripsi.size() <= 1500
        && (!('kategori' in data) || (data.kategori is string && data.kategori.size() >= 1 && data.kategori.size() <= 60))
        && (!('linkPaket' in data) || isValidLinkPaket(data.linkPaket))
        && isValidHargaPaket(data.hargaPaket)
        && isValidHargaPromo(data.hargaPromo)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPackage(data) {
      return data.keys().hasAll([
          'namaPaket', 'harga', 'hargaCoret', 'promoAktif', 'labelPromo',
          'order', 'fitur', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'namaPaket', 'harga', 'hargaCoret', 'promoAktif', 'labelPromo',
          'order', 'fitur', 'createdAt', 'updatedAt'
        ])
        && data.namaPaket is string && data.namaPaket.size() >= 1 && data.namaPaket.size() <= 60
        && data.harga is number && data.harga >= 0 && data.harga <= 100000000
        && data.hargaCoret is number && data.hargaCoret >= 0 && data.hargaCoret <= 100000000
        && data.promoAktif is bool
        && data.labelPromo is string && data.labelPromo.size() <= 60
        && data.order is number && data.order >= 1 && data.order <= 100
        && data.fitur is list && data.fitur.size() <= 30
        && (data.fitur.size() == 0 || (
          data.fitur[0] is map
          && data.fitur[0].keys().hasAll(['nama', 'tersedia'])
          && data.fitur[0].keys().hasOnly(['id', 'nama', 'tersedia'])
          && data.fitur[0].nama is string && data.fitur[0].nama.size() >= 1 && data.fitur[0].nama.size() <= 200
          && data.fitur[0].tersedia is bool
        ))
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'templateId', 'templateName', 'paketDipilih', 'hargaBayar',
          'namaPria', 'namaWanita', 'tanggalAcara', 'namaPemesan',
          'noWA', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'templateId', 'templateName', 'paketDipilih', 'hargaBayar',
          'namaPria', 'namaWanita', 'tanggalAcara', 'namaPemesan',
          'noWA', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.templateId)
        && data.templateName is string && data.templateName.size() >= 1 && data.templateName.size() <= 120
        && isValidId(data.paketDipilih) && data.paketDipilih.size() <= 60
        && data.hargaBayar is number && data.hargaBayar >= 0 && data.hargaBayar <= 100000000
        && data.namaPria is string && data.namaPria.size() >= 1 && data.namaPria.size() <= 120
        && data.namaWanita is string && data.namaWanita.size() >= 1 && data.namaWanita.size() <= 120
        && data.tanggalAcara is string && data.tanggalAcara.size() >= 1 && data.tanggalAcara.size() <= 40
        && data.namaPemesan is string && data.namaPemesan.size() >= 1 && data.namaPemesan.size() <= 120
        && data.noWA is string && data.noWA.size() >= 6 && data.noWA.size() <= 30
        && data.status is string && data.status in ['baru', 'diproses', 'selesai']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['username', 'email', 'role'])
        && data.keys().hasOnly(['username', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 50 && data.username.matches('^[a-zA-Z0-9_\\.\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role is string && data.role == 'admin';
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['noWaAdmin', 'updatedAt'])
        && data.keys().hasOnly(['noWaAdmin', 'updatedAt'])
        && data.noWaAdmin is string && data.noWaAdmin.size() <= 30
        && data.updatedAt is timestamp;
    }

    function isValidWebsiteImages(data) {
      return data.keys().hasAll(['heroImage', 'alurImage', 'updatedAt'])
        && data.keys().hasOnly(['heroImage', 'alurImage', 'updatedAt'])
        && data.heroImage is string && data.heroImage.size() <= 420000
        && data.alurImage is string && data.alurImage.size() <= 420000
        && data.updatedAt is timestamp;
    }

    // Templates Catalog: Public read, Admin-only write
    match /templates/{templateId} {
      allow list: if true;
      allow get: if isValidId(templateId);

      allow create: if isAdmin()
        && isValidId(templateId)
        && isValidTemplate(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(templateId)
        && isValidTemplate(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'namaTemplate', 'fotoThumbnail', 'linkWebsite', 'deskripsi',
          'kategori', 'linkPaket', 'hargaPaket', 'hargaPromo', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(templateId);
    }

    // Packages (Bronze, Silver, Gold, Platinum, and custom packages): Public read, Admin-only write
    match /packages/{packageId} {
      allow list: if true;
      allow get: if isValidId(packageId);

      allow create: if isAdmin()
        && isValidId(packageId) && packageId.size() <= 60
        && isValidPackage(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(packageId) && packageId.size() <= 60
        && isValidPackage(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'namaPaket', 'harga', 'hargaCoret', 'promoAktif', 'labelPromo',
          'order', 'fitur', 'updatedAt'
        ]);

      allow delete: if isAdmin()
        && isValidId(packageId)
        && !(packageId in ['bronze', 'silver', 'gold', 'platinum']);
    }

    // Orders: Public create (with strict template existence & initial 'baru' status), Admin-only read/update/delete
    match /orders/{orderId} {
      allow list: if isAdmin();
      allow get: if isAdmin() && isValidId(orderId);

      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().status == 'baru'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/templates/$(incoming().templateId));

      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().templateId == existing().templateId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if request.query.limit != null && request.query.limit <= 1 && resource.data.role == 'admin';

      allow create: if isSignedIn()
        && isValidId(adminId)
        && request.auth.uid == adminId
        && request.auth.token.email == 'admin@sekarkencana.id'
        && isValidAdmin(incoming())
        && incoming().username == 'admin'
        && incoming().email == 'admin@sekarkencana.id'
        && incoming().role == 'admin';

      allow update: if isAdmin()
        && isValidId(adminId)
        && request.auth.uid == adminId
        && isValidAdmin(incoming())
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'updatedAt']);

      allow delete: if false;
    }

    // Store settings (settings/whatsapp, settings/images, and legacy settings/store)
    match /settings/{settingId} {
      allow get: if settingId in ['store', 'whatsapp', 'images'];
      allow list: if false;

      allow create: if isAdmin()
        && incoming().updatedAt == request.time
        && (
          (settingId in ['store', 'whatsapp'] && isValidStoreSettings(incoming())) ||
          (settingId == 'images' && isValidWebsiteImages(incoming()))
        );

      allow update: if isAdmin()
        && incoming().updatedAt == request.time
        && (
          (settingId in ['store', 'whatsapp']
            && isValidStoreSettings(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['noWaAdmin', 'updatedAt'])) ||
          (settingId == 'images'
            && isValidWebsiteImages(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['heroImage', 'alurImage', 'updatedAt']))
        );

      allow delete: if false;
    }
  }
}
